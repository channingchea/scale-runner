<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Supabase, RevenueCat, Firebase and Google Sign-In all need outbound
	     network. Without this the sandbox silently blocks every request. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- BLE MIDI: the flutter_midi_command central and the CoreAudioKit
	     pairing window (see BleMidiChannel.swift). -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:scalerunner.c1gnus.com</string>
	</array>
</dict>
</plist>
